{
    "name": "hasanalyazidi/laravel-datatables",
    "description": "Lightweight server-side engine for jQuery DataTables: one PHP class, one route line, one Blade tag — with Excel, CSV and PDF (Arabic/RTL-capable) exports.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/HasanAlyazidi/laravel-datatables",
    "keywords": [
        "datatables",
        "laravel",
        "server-side",
        "jquery",
        "export",
        "excel",
        "pdf",
        "csv"
    ],
    "authors": [
        {
            "name": "Hasan Al-Yazidi",
            "email": "hassanx220@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^7.1|^8.0",
        "illuminate/database": "^6|^7|^8|^9|^10|^11|^12|^13",
        "illuminate/http": "^6|^7|^8|^9|^10|^11|^12|^13",
        "illuminate/routing": "^6|^7|^8|^9|^10|^11|^12|^13",
        "illuminate/support": "^6|^7|^8|^9|^10|^11|^12|^13",
        "illuminate/view": "^6|^7|^8|^9|^10|^11|^12|^13"
    },
    "require-dev": {
        "laravel/framework": "^6|^7|^8|^9|^10|^11|^12|^13",
        "orchestra/testbench": "^4|^5|^6|^7|^8|^9|^10|^11",
        "phpunit/phpunit": "^8.5|^9|^10|^11|^12"
    },
    "suggest": {
        "maatwebsite/excel": "Required for the Excel (.xlsx) exporter (^3.1).",
        "carlos-meneses/laravel-mpdf": "Required for the PDF exporters (^2.1)."
    },
    "autoload": {
        "psr-4": {
            "HasanAlyazidi\\DataTables\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HasanAlyazidi\\DataTables\\Tests\\": "tests/"
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "HasanAlyazidi\\DataTables\\DataTablesServiceProvider"
            ]
        }
    }
}
